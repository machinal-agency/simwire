{
  "name": "simwire",
  "version": "0.1.0",
  "description": "Send and receive real SMS from Node.js through your own Android phone. No Twilio, no signup — your SIM is the gateway.",
  "keywords": ["sms", "gateway", "android", "otp", "2fa", "testing", "local"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simwire": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simwire/protocol": "workspace:*",
    "bonjour-service": "^1.3.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
