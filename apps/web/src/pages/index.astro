    animation: segflow 2.6s ease-in-out infinite;
  }
  .pill-line .seg + .spill + .seg::after { animation-delay: 1.3s; }
  @keyframes segflow { 0% { transform: translateX(-100%); } 55%, 100% { transform: translateX(100%); } }

  .sims { display: flex; gap: 10px; }
  .sim { flex: 1; border: 1px solid var(--g200); background: var(--g50); border-radius: 12px; padding: 12px 14px; font-family: var(--mono); font-size: 10.5px; color: var(--g400); position: relative; }
  .sim .nm { display: block; font-size: 12.5px; color: var(--g600); margin-top: 2px; font-weight: 600; font-family: var(--sans); }
  .sim.on { border-color: var(--violet); background: var(--violet-soft); }
  .sim.on .nm { color: var(--violet); }
  .sim .notch { position: absolute; top: 0; right: 14px; width: 14px; height: 3px; border-radius: 0 0 3px 3px; background: var(--g200); }
  .sim.on .notch { background: var(--violet); }

  .checks { font-family: var(--mono); font-size: 11.5px; line-height: 2.1; color: var(--g600); }
  .checks .ok { color: var(--green); }
  .checks .bad { color: var(--amber); }
  .checks .dim { color: var(--g400); }

  .qbars { display: flex; align-items: flex-end; gap: 5px; height: 34px; }
  .qbars b { flex: 1; background: linear-gradient(180deg, var(--violet) -40%, var(--violet-soft) 120%); border-radius: 4px 4px 0 0; }

  .proto-chip {
    font-family: var(--mono); font-size: 11.5px; color: var(--g600);
    border: 1px solid var(--g200); background: var(--g50);
    border-radius: 9px; padding: 9px 13px; display: inline-block;
  }

  /* code */
  .codebox { border-radius: 24px; overflow: hidden; background: var(--dark); }
  .tabs2 { display: flex; border-bottom: 1px solid var(--dark-line); padding: 0 10px; background: #16161c; }
  .tab2 {
    font-family: var(--mono); font-size: 12.5px; color: var(--dk-text3);
    background: none; border: none; border-bottom: 2px solid transparent;
    padding: 14px 16px; cursor: pointer; margin-bottom: -1px;
    transition: color 0.15s;
  }
  .tab2:hover { color: var(--dk-text2); }
  .tab2[aria-selected="true"] { color: #fff; border-bottom-color: var(--violet); }
  .panel { display: none; padding: 26px 28px; font-family: var(--mono); font-size: 13px; line-height: 1.9; overflow-x: auto; text-align: left; }
  .panel.on { display: block; }
  .panel pre { color: #d6d6de; }
  .panel .k { color: #a999ff; }
  .panel .s { color: #4ade80; }
  .panel .c { color: var(--dk-text3); }

  /* compare */
  .cmp { background: #fff; border: 1px solid var(--g200); border-radius: 20px; overflow: hidden; }
  .cmp-scroll { overflow-x: auto; }
  .cmp table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 640px; }
  .cmp th, .cmp td { text-align: left; padding: 15px 24px; border-top: 1px solid var(--g100); }
  .cmp thead th {
    border-top: none; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 600; color: var(--g500); background: var(--g50);
    padding-top: 16px; padding-bottom: 14px;
  }
  .cmp thead th.me { color: var(--ink); }
  .cmp td:first-child { color: var(--g500); font-size: 13.5px; }
  .cmp td.me { color: var(--ink); font-weight: 550; background: var(--g50); }
  .cmp td { color: var(--g600); }
  .cmp .y { color: var(--green); font-weight: 600; }
  .cmp .n { color: var(--g400); }

  .honesty {
    margin: 20px auto 0; display: flex; gap: 14px; align-items: flex-start;
    color: var(--g600); font-size: 14px; max-width: 78ch;
    background: #fffbeb; border: 1px solid #fde9c0;
    border-radius: 16px; padding: 18px 20px; text-align: left;
  }
  .honesty .w { color: var(--amber); font-size: 14px; margin-top: 1px; }
  .honesty strong { color: var(--ink); font-weight: 600; }

  /* final */
  .final { padding: 120px 24px 100px; max-width: 80rem; margin: 0 auto; }
  .final-card {
    background: var(--ink); color: #fff; border-radius: 32px;
    text-align: center; padding: clamp(56px, 8vw, 96px) 28px;
    position: relative; overflow: hidden;
  }
  .final-card::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(480px 240px at 80% 0%, rgba(109, 77, 250, 0.28), transparent 70%);
  }
  .final-card h2 {
    font-size: clamp(32px, 4.6vw, 52px); font-weight: 400;
    letter-spacing: -0.03em; line-height: 1.08; text-wrap: balance;
    margin-bottom: 14px; position: relative;
  }
  .final-card h2 code { font-family: var(--mono); font-size: 0.85em; }
  .final-card p { color: rgba(255, 255, 255, 0.65); margin-bottom: 34px; position: relative; }
  .final-card .row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; position: relative; }
  .pill-white { background: #fff; color: var(--ink); }
  .pill-white:hover { background: var(--g100); }
  .pill-ghost { background: transparent; border: 1px solid rgba(255, 255, 255, 0.35); color: #fff; }
  .pill-ghost:hover { border-color: #fff; background: transparent; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .fiu { opacity: 1; animation: none; }
    .ov-anim, .dlg { animation: none; }
    .rv { opacity: 1; }
    .rv.vis { animation: none; }
    .bub { opacity: 1; transform: none; transition: none; }
    .mini-dark .cur { animation: none; }
    .pill-line .seg::after { animation: none; transform: none; opacity: 0.3; }
    .blob { animation: none; }
    .marquee-inner { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .marquee { mask-image: none; -webkit-mask-image: none; }
    .prog i { transition: none; }
