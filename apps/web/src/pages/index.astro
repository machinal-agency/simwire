</style>

<script is:inline>
const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  for (const btn of document.querySelectorAll("[data-copy]")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        const hint = btn.querySelector(".hint");
        if (hint) {
          const prev = hint.textContent;
          hint.textContent = "Copied!";
          setTimeout(() => (hint.textContent = prev), 1500);
        }
      } catch { /* clipboard unavailable */ }
    });
  }

  // Scroll reveal. Elements entering in the same batch stagger their delays,
  // and once the entrance finishes, .rv-done releases the animation so hover
  // transforms (cards, steps) take over cleanly.
  const io = new IntersectionObserver((es) => {
    const batch = es.filter((e) => e.isIntersecting);
    batch.forEach((e, i) => {
      const el = e.target;
      el.style.setProperty("--rvd", Math.min(i * 70, 350) + "ms");
      el.addEventListener("animationend", function done(ev) {
        if (ev.animationName !== "rvIn") return;
        el.classList.add("rv-done");
        el.removeEventListener("animationend", done);
      });
      el.classList.add("vis");
      io.unobserve(el);
    });
  }, { threshold: 0.1 });
  for (const el of document.querySelectorAll(".rv")) io.observe(el);

  // "How it works": step rows drive the terminal panel on the right
  for (const row of document.querySelectorAll(".hrow")) {
    row.addEventListener("click", () => {
      for (const r of document.querySelectorAll(".hrow")) {
        r.classList.toggle("on", r === row);
        r.setAttribute("aria-selected", r === row ? "true" : "false");
      }
      for (const p of document.querySelectorAll(".how-pane")) {
        p.classList.toggle("on", p.id === row.dataset.pane);
      }
    });
  }

  for (const tab of document.querySelectorAll(".tab2")) {
    tab.addEventListener("click", () => {
      for (const t of document.querySelectorAll(".tab2")) t.setAttribute("aria-selected", t === tab ? "true" : "false");
      for (const p of document.querySelectorAll(".panel")) p.classList.toggle("on", p.id === tab.dataset.p);
    });
  }

  // ------- demo tabs: auto-cycle every 4s -------
  const TABS = ["pair", "send", "receive", "test"];
  let current = "pair";
  let cycle = null;

  function setTab(name) {
    current = name;
    for (const b of document.querySelectorAll(".tabbtn")) {
      b.setAttribute("aria-selected", b.dataset.tab === name ? "true" : "false");
    }
    for (const ov of document.querySelectorAll(".overlay")) {
      const on = ov.id === "ov-" + name;
      const bar = ov.querySelector(".prog i");
      if (on && !ov.classList.contains("on")) {
        ov.classList.add("on");
        if (!reduced) {
          const dlg = ov.querySelector(".dlg");
          ov.style.animation = "none";
          if (dlg) dlg.style.animation = "none";
          void ov.offsetWidth;
          ov.style.animation = "";
          if (dlg) dlg.style.animation = "";
        }
        if (bar) requestAnimationFrame(() => { bar.style.width = bar.dataset.w; });
      } else if (!on) {
        ov.classList.remove("on");
        if (bar) bar.style.width = "0";
      }
    }
  }
  function startCycle() {
    clearInterval(cycle);
    cycle = setInterval(() => {
      setTab(TABS[(TABS.indexOf(current) + 1) % TABS.length]);
    }, 4000);
  }
  for (const b of document.querySelectorAll(".tabbtn")) {
    b.addEventListener("click", () => { setTab(b.dataset.tab); startCycle(); });
  }
  const firstBar = document.querySelector("#ov-pair .prog i");
  if (firstBar) requestAnimationFrame(() => { firstBar.style.width = firstBar.dataset.w; });
  startCycle();

  // ------- background scene -------
  const term = document.getElementById("term");
  const msgs = document.getElementById("msgs");

  function tline(html) {
    const el = document.createElement("div");
    el.innerHTML = html;
    term.appendChild(el);
    return el;
  }
  async function ttype(cmd) {
    const el = tline('<span class="tp">$ </span>');
    const txt = document.createTextNode("");
    el.appendChild(txt);
    for (const ch of cmd) { txt.textContent += ch; await wait(24); }
    await wait(320);
  }
  function bubble(kind, who, text, status) {
    const el = document.createElement("div");
    el.className = "bub " + kind;
    el.innerHTML = '<span class="who"></span><span class="txt"></span>' + (status ? '<span class="st"></span>' : "");
    el.querySelector(".who").textContent = who;
    el.querySelector(".txt").textContent = text;
    if (status) el.querySelector(".st").textContent = status;
    msgs.appendChild(el);
    requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add("show")));
    return el;
  }
  const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");

  async function scene() {
    term.textContent = "";
    msgs.textContent = "";
    await wait(500);
    await ttype("node send-otp.js");
    tline('<span class="td">simwire · connected to Pixel 8 (LAN)</span>');
    await wait(900);
    const out = bubble("out", "to +1 555 014 2834", "Your code is 4821", "queued");
    await wait(700);
    out.querySelector(".st").textContent = "sent · SIM 1";
    tline('<span class="tk">✓</span> sent <span class="td">0.6s</span>');
    await wait(1000);
    out.querySelector(".st").textContent = "delivered ✓";
    tline('<span class="tk">✓</span> delivered <span class="td">1.8s</span>');
    await wait(1700);
    bubble("in", "ACME BANK", "BANK: You received $250.00 from ACME Corp");
    await wait(900);
    tline('<span class="ti">← sms:received  ACME BANK  ' + esc('"BANK: You received…"') + "</span>");
    await wait(500);
    tline('<span class="td">→ POST localhost:3000/sms  </span><span class="tk">200</span>');
    await wait(4200);
    scene();
  }
  function sceneStatic() {
    term.innerHTML = "";
    tline('<span class="tp">$ </span>node send-otp.js');
    tline('<span class="td">simwire · connected to Pixel 8 (LAN)</span>');
    tline('<span class="tk">✓</span> sent <span class="td">0.6s</span>');
    tline('<span class="tk">✓</span> delivered <span class="td">1.8s</span>');
    tline('<span class="ti">← sms:received  ACME BANK  "BANK: You received…"</span>');
    tline('<span class="td">→ POST localhost:3000/sms  </span><span class="tk">200</span>');
    bubble("out", "to +1 555 014 2834", "Your code is 4821", "delivered ✓");
    bubble("in", "ACME BANK", "BANK: You received $250.00 from ACME Corp");
  }
  if (reduced) sceneStatic(); else scene();
</script>
