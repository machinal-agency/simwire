  }
  .spill.on { color: var(--green); border-color: rgba(22, 163, 74, 0.35); background: var(--green-soft); }
  .pill-line .seg { flex: 1; height: 2px; min-width: 12px; background: var(--g200); position: relative; overflow: hidden; border-radius: 2px; }
  .pill-line .seg::after {
    content: ""; position: absolute; inset: 0; transform: translateX(-100%);
